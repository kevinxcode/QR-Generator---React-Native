{
  "expo": {
    "name": "Qraft",
    "slug": "qr-code-generator",
    "version": "1.0.0",
    "scheme": "qraft",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kevinalnizar.iclick.qr",
      "runtimeVersion": {
        "policy": "sdkVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#6C4FF6"
      },
      "package": "com.fadedind.qraft.qr",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "de38bd5a-22cf-460c-9d10-3dc06689de11"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/de38bd5a-22cf-460c-9d10-3dc06689de11"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-sqlite",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#EEF0FF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0D17"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Qraft uses the camera to scan QR codes and barcodes. Images never leave your device.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Qraft needs photo access to scan codes from images and to add logos to your QR codes."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Qraft needs photo access to scan codes from images and to add logos to your QR codes.",
          "savePhotosPermission": "Qraft saves exported QR codes and barcodes to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-image",
      "./plugins/withReleaseSigning"
    ]
  }
}
